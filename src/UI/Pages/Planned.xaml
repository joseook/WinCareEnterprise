<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,20,24,24" MaxWidth="820" HorizontalAlignment="Left">
        <Border Style="{DynamicResource Card}">
            <StackPanel>
                <TextBlock x:Name="PlannedPhase" Style="{DynamicResource Text.Muted}"/>
                <TextBlock x:Name="PlannedTitle" Style="{DynamicResource Text.H2}"/>
                <TextBlock x:Name="PlannedText" Style="{DynamicResource Text.Body}"/>
                <TextBlock Text="{DynamicResource str.planned.note}" Style="{DynamicResource Text.Muted}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <ItemsControl x:Name="PlannedItems" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{DynamicResource Card}" Margin="0,0,0,8" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{DynamicResource Text.Body}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}" Style="{DynamicResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</ScrollViewer>
