<ScrollViewer xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" VerticalScrollBarVisibility="Auto" Focusable="False">
    <StackPanel Margin="24,20,24,24">
        <TextBlock x:Name="ActionsIntro" Style="{DynamicResource Text.Muted}" Margin="0,0,0,12"/>
        <TextBlock x:Name="ActionsProfileHint" Style="{DynamicResource Text.Muted}" Margin="0,0,0,12" Foreground="{DynamicResource Brush.Warning}"/>
        <TextBlock x:Name="ActionsEmptyText" Text="{DynamicResource str.actions.empty}" Style="{DynamicResource Text.Muted}"/>
        <StackPanel x:Name="ActionsList"/>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
            <Button x:Name="PreviewButton" Style="{DynamicResource Button.Secondary}" Content="{DynamicResource str.actions.preview}"/>
            <Button x:Name="RunButton" Style="{DynamicResource Button.Primary}" Content="{DynamicResource str.actions.run}"/>
        </StackPanel>
        <TextBlock Text="{DynamicResource str.actions.results}" Style="{DynamicResource Text.H2}"/>
        <DataGrid x:Name="ResultGrid" Style="{DynamicResource Grid.Data}" Margin="0,0,0,12"/>
        <TextBlock Text="{DynamicResource str.actions.details}" Style="{DynamicResource Text.H2}"/>
        <DataGrid x:Name="DetailGrid" Style="{DynamicResource Grid.Data}" MaxHeight="320" Margin="0,0,0,12"/>
        <TextBox x:Name="OutputBox" Height="180" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" FontSize="12" Padding="6"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource Brush.SurfaceAlt}" Foreground="{DynamicResource Brush.Text}" BorderBrush="{DynamicResource Brush.Border}"
                 AutomationProperties.Name="Output"/>
    </StackPanel>
</ScrollViewer>
